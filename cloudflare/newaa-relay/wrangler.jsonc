{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "newaa-music-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "MUSIC_ROOM", "class_name": "MusicRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MusicRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inazuma-playlists",
      "database_id": "d430d39e-376f-47ec-be3f-d5d7b154f515",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
