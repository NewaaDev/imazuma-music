# Jeton du bot (Discord Developer Portal > Bot)
DISCORD_TOKEN=
# Application ID (Discord Developer Portal > General Information)
DISCORD_CLIENT_ID=
# Recommandé pendant le développement : déploiement instantané sur un serveur
DISCORD_GUILD_ID=

# Exécutable yt-dlp. Laisser yt-dlp s'il est disponible dans le PATH.
YTDLP_PATH=./yt-dlp_linux
# Délai avant déconnexion une fois la file terminée (millisecondes)
# 0 = rester dans le vocal après la fin de la file
IDLE_DISCONNECT_MS=0
# Volume initial, de 0 à 100
DEFAULT_VOLUME=50

# Annonces privées de publication Inazuma Music (aucun réglage dans l'application)
RELEASE_ANNOUNCEMENTS=true
RELEASE_CHANNEL_ID=1468549168200024086
