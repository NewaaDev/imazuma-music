{
  "name": "discord-youtube-music-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot musique Discord avec commandes slash, files par serveur et backend yt-dlp isolé.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "deploy-commands": "node scripts/deploy-commands.js",
    "check": "node --check src/index.js && node --test --test-isolation=none"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.21.0",
    "dotenv": "17.4.2",
    "ffmpeg-static": "5.3.0",
    "libsodium-wrappers": "0.8.4",
    "opusscript": "0.1.1",
    "ws": "^8.18.3"
  }
}
