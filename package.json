{
  "name": "inazuma-music-desktop",
  "version": "2.2.10",
  "private": true,
  "description": "Application Windows de contrôle pour Inazuma Music",
  "author": "NEWAA",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm test && tsc -b && vite build && tsc -p electron/tsconfig.json && electron-builder --win nsis --publish never && electron-builder --win portable --publish never --config.win.artifactName=Inazuma-Music-${version}-${arch}-portable.${ext} && node scripts/verify-packaged-ui.mjs",
    "build:dir": "tsc -b && vite build && tsc -p electron/tsconfig.json && electron-builder --dir",
    "typecheck": "tsc -b --pretty false && tsc -p electron/tsconfig.json --pretty false",
    "test": "node scripts/playback-isolation.test.mjs && node scripts/announce-discord-release.test.mjs && node scripts/verify-packaged-ui.test.mjs",
    "test:playback": "node scripts/playback-isolation.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/discord-rpc": "^4.0.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1",
    "wrangler": "^4.125.0"
  },
  "build": {
    "appId": "fr.newaa.music",
    "productName": "Inazuma Music",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "!assets/remote-access-token.txt",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "NewaaDev",
        "repo": "imazuma-music",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Inazuma-Music-${version}-${arch}-setup.${ext}",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
